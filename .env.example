# Modelo de configuração. Copie para .env e edite o que quiser mudar:
#
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# O projeto sobe sem .env nenhum — todos os valores abaixo já são o padrão do
# docker-compose.yml. Depois de editar, rode `docker compose up -d` para recriar
# os containers; variável de ambiente não entra em container já rodando.
#
# ATENÇÃO: o .env fica fora do git (.gitignore). Valores reais vão nele, nunca
# aqui. Ver a seção "Configuração (.env)" do README.

# Banco — estes três alimentam o container do Postgres E a connection string da API.
POSTGRES_DB=controle_gastos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432

# API (.NET)
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
CORS_ORIGINS=http://localhost:3000;http://localhost:5173

# Frontend (nginx)
WEB_PORT=3000
